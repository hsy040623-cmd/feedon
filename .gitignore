# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# bkit 플러그인 로컬 세션 상태(토큰 로그·감사 기록 등, 커밋 대상 아님)
.bkit

# 서브에이전트 로컬 세션 메모리 (커밋 대상 아님)
.claude/agent-memory

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 폴더 (사용자가 직접 확인 후 지움)
trash-can
